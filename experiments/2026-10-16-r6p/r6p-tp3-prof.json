{
 "notes": "r6p on TP3 (the recipe's tp3-triangle) with vLLM's torch profiler.",
 "extends": {
  "config": "experiments/2026-10-16-r6p/r6p-tp3.json"
 },
 "set": {
  "serve_args": [
   "/models",
   "--served-model-name",
   "deepseek-v4.1-flash",
   "--host",
   "0.0.0.0",
   "--port",
   "8000",
   "--tokenizer-mode",
   "deepseek_v41",
   "--dtype",
   "bfloat16",
   "--tensor-parallel-size",
   "3",
   "--load-format",
   "b12x",
   "--block-size",
   "256",
   "--enable-prefix-caching",
   "--enable-chunked-prefill",
   "--max-model-len",
   "524288",
   "--max-num-seqs",
   "8",
   "--max-parallel-prefills",
   "1",
   "--gpu-memory-utilization",
   "0.82",
   "--max-num-batched-tokens",
   "4096",
   "--kv-cache-memory-bytes",
   "3758096384",
   "--max-cudagraph-capture-size",
   "48",
   "--generation-config",
   "vllm",
   "--engram-config",
   "{\"table_memory\":\"disk\",\"disk_resident_scales\":false,\"projection_tp\":true}",
   "--attention-backend",
   "TILELANG",
   "--linear-backend",
   "tilelang",
   "--moe-backend",
   "tilelang",
   "--speculative-config",
   "{\"method\":\"dspark\",\"num_speculative_tokens\":5,\"draft_tensor_parallel_size\":3,\"attention_backend\":\"TILELANG\",\"draft_sample_method\":\"greedy\",\"rejection_sample_method\":\"block\",\"enable_adaptive_verification\":true,\"adaptive_verification_cost_scale\":2.0}",
   "--jit-monitor-mode",
   "warn",
   "--compilation-config",
   "{\"cudagraph_mode\":\"FULL_AND_PIECEWISE\",\"custom_ops\":[\"all\"],\"cudagraph_capture_sizes\":[1,2,3,4,6,8,12,16,20,24,28,32,40,48]}",
   "--prefix-cache-retention-interval",
   "512",
   "--long-prefill-token-threshold",
   "4048",
   "--async-scheduling",
   "--reasoning-parser",
   "deepseek_v41",
   "--tool-call-parser",
   "deepseek_v41",
   "--enable-auto-tool-choice",
   "--distributed-executor-backend",
   "mp",
   "--nnodes",
   "3",
   "--no-scheduler-reserve-full-isl",
   "--no-enable-flashinfer-autotune",
   "--limit-mm-per-prompt",
   "{\"image\":4}",
   "--mm-processor-cache-gb",
   "0",
   "--profiler-config",
   "{\"profiler\": \"torch\", \"torch_profiler_dir\": \"/cache/kkref/profiles/tp3-prefill-r6p\", \"torch_profiler_with_stack\": false, \"torch_profiler_record_shapes\": true, \"ignore_frontend\": true, \"torch_profiler_use_gzip\": true}"
  ]
 }
}
