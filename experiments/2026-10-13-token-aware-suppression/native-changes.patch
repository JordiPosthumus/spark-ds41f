+"""Request-local, bounded phrase masking for the pinned V2 sampler.
+
+Prototype: review and GPU validation required before deployment.
+Only server-owned SamplingParams._ds41f_phrase_suppression enables a request.
+Committed GPU state never includes unaccepted speculative tokens.
+"""
+import os
+
+import numpy as np
+import torch
+
+from vllm.triton_utils import tl, triton
+from vllm.v1.worker.gpu.buffer_utils import StagedWriteTensor
+
+# Exact native model IDs; validated against compiler manifest at load.
+CONTROL_IDS = (1, 128822, 128825)  # EOS, </think>, DSML control marker.
+WORD_LIMIT = 60
+# GPU state columns: lexical state, UTF8 state, completed words, scan position,
+# active, seed lexical state, seed UTF8 state, seed prompt length. A fixed-width
+# tensor makes initialization/reuse one staged write.
+_STATE_WIDTH = 8
+
+
+@triton.jit
+def _advance_token(
+    token, lex, utf, words, active,
+    token_prefix_ptr, token_body_ptr, bridge_ptr, lex_ptr, body_ptr,
+    body_nonempty_ptr, body_tail_ptr,
+    PREFIXES: tl.constexpr, BODIES: tl.constexpr,
+):
+    """Vectorizable native-token transition with exact word-TTL masking.
+
+    first forbidden indices are one-based completed-word positions. A forbidden
+    phrase in word 60 is still masked; word 61 is not. Control tokens are exempt
+    even if they terminate a partial target word and disarm future positions.
+    """
+    old_lex, old_utf, old_words = lex, utf, words
+    is_control = (token == 1) | (token == 128822) | (token == 128825)
+    was_active = active & ~is_control
+    prefix = tl.load(token_prefix_ptr + token)
+    body_id = tl.load(token_body_ptr + token)
+    bridge = tl.load(bridge_ptr + utf * PREFIXES + prefix)
+    new_utf = bridge & 511
+    count = (bridge >> 9) & 3
+    bad = tl.full((), False, tl.int1)
+    for event in tl.static_range(3):
+        category = (bridge >> (11 + event * 4)) & 15
+        # Absent bridge events can encode unused bits. Clamp before the load.
+        category = tl.where(event < count, category, 0)
+        step = tl.load(lex_ptr + lex * 13 + category)
+        step_words = (step >> 5) & 255
+        first_bad = (step >> 13) & 255
+        use = event < count
+        bad = bad | (use & (first_bad != 255) & (words + first_bad <= 60))
+        lex = tl.where(use, step & 31, lex)
+        words = words + tl.where(use, step_words, 0)
+    body_exists = tl.load(body_nonempty_ptr + body_id) != 0
+    step = tl.load(body_ptr + lex * BODIES + body_id)
+    step_words = (step >> 5) & 255
+    first_bad = (step >> 13) & 255
+    bad = bad | (body_exists & (first_bad != 255) & (words + first_bad <= 60))
+    lex = tl.where(body_exists, step & 31, lex)
+    words = words + tl.where(body_exists, step_words, 0)
+    tail = tl.load(body_tail_ptr + body_id)
+    new_utf = tl.where(body_exists, tail, new_utf)
+    active = was_active & (words < 60)
+    return (tl.where(was_active, lex, old_lex),
+            tl.where(was_active, new_utf, old_utf),
+            tl.where(was_active, tl.minimum(words, 60), old_words),
+            active, bad & was_active)
+
+
+@triton.jit
+def _update_committed(
+    idx_mapping_ptr, states_ptr, all_ids_ptr, all_ids_stride,
+    total_len_ptr, token_prefix_ptr, token_body_ptr, bridge_ptr, lex_ptr,
+    body_ptr, body_nonempty_ptr, body_tail_ptr,
+    PREFIXES: tl.constexpr, BODIES: tl.constexpr,
+):
+    batch_row = tl.program_id(0)
+    req = tl.load(idx_mapping_ptr + batch_row)
+    if req < 0:
+        return
+    base = states_ptr + req * 8
+    active = tl.load(base + 4) != 0
+    if not active:
+        return
+    lex = tl.load(base)
+    utf = tl.load(base + 1)
+    words = tl.load(base + 2)
+    scan = tl.load(base + 3)
+    end = tl.load(total_len_ptr + req)
+    # Normally monotonic. Recompute from the immutable trusted seed if native
+    # accepted history contracts, instead of retaining rejected suffix state.
+    if scan > end:
+        lex = tl.load(base + 5)
+        utf = tl.load(base + 6)
+        scan = tl.load(base + 7)
+        words = 0
+    if end < scan:
+        return
+    while scan < end and active:
+        token = tl.load(all_ids_ptr + req * all_ids_stride + scan)
+        lex, utf, words, active, ignored_bad = _advance_token(
+            token, lex, utf, words, active,
+            token_prefix_ptr, token_body_ptr, bridge_ptr, lex_ptr, body_ptr,
+            body_nonempty_ptr, body_tail_ptr, PREFIXES, BODIES,
+        )
+        scan += 1
+    tl.store(base, lex)
+    tl.store(base + 1, utf)
+    tl.store(base + 2, words)
+    tl.store(base + 3, end)
+    tl.store(base + 4, active.to(tl.int32))
+
+
+@triton.jit
+def _mask_rows(
+    logits_ptr, logits_stride, expanded_mapping_ptr, local_pos_ptr,
+    input_ids_ptr, states_ptr,
+    token_prefix_ptr, token_body_ptr, bridge_ptr, lex_ptr, body_ptr,
+    body_nonempty_ptr, body_tail_ptr,
+    PREFIXES: tl.constexpr, BODIES: tl.constexpr,
+    VOCAB: tl.constexpr, BLOCK: tl.constexpr,
+):
+    row = tl.program_id(0)
+    req = tl.load(expanded_mapping_ptr + row)
+    if req < 0:
+        return
+    base = states_ptr + req * 8
+    active = tl.load(base + 4) != 0
+    if not active:
+        return
+    lex = tl.load(base)
+    utf = tl.load(base + 1)
+    words = tl.load(base + 2)
+    pos = tl.load(local_pos_ptr + row)
+    request_first_row = row - pos
+    # Local position zero is the last committed token, already reflected in
+    # cache. Positions 1..pos are draft tokens preceding this target/bonus row.
+    for i in range(pos):
+        token = tl.load(input_ids_ptr + request_first_row + i + 1)
+        # Native verification may materialize rows after a -1 draft placeholder.
+        # Such rows are unreachable; never index token tables with a sentinel.
+        valid_token = (token >= 0) & (token < VOCAB)
+        active = active & valid_token
+        token = tl.where(valid_token, token, 1)
+        lex, utf, words, active, ignored_bad = _advance_token(
+            token, lex, utf, words, active,
+            token_prefix_ptr, token_body_ptr, bridge_ptr, lex_ptr, body_ptr,
+            body_nonempty_ptr, body_tail_ptr, PREFIXES, BODIES,
+        )
+    if not active:
+        return
+    ids = tl.program_id(1) * BLOCK + tl.arange(0, BLOCK)
+    valid = ids < VOCAB
+    # Padded lanes use a valid control token and never write logits.
+    safe_ids = tl.where(valid, ids, 1)
+    out_lex, out_utf, out_words, out_active, bad = _advance_token(
+        safe_ids, lex, utf, words, active,
+        token_prefix_ptr, token_body_ptr, bridge_ptr, lex_ptr, body_ptr,
+        body_nonempty_ptr, body_tail_ptr, PREFIXES, BODIES,
+    )
+    tl.store(logits_ptr + row * logits_stride + ids, -float("inf"), mask=valid & bad)
+
+
+class PhraseSuppressionState:
+    """No device synchronization and no extra launches for untracked batches."""
+
+    def __init__(self, req_states):
+        self.req_states = req_states
+        self.use_suppression = np.zeros(req_states.max_num_reqs, dtype=bool)
+        table_dir = os.environ.get("SPARK_DS41F_PHRASE_TABLES")
+        self.enabled = os.environ.get("SPARK_DS41F_TEMPORARY_PHRASES") == "1" and bool(table_dir)
+        self.tables = None
+        self._pending_resets = {}
+        if not self.enabled:
+            return
+        # Pure-CPU shared loader checks hashes, dimensions, native model IDs and
+        # fixed policy before any GPU allocation. Its final location is supplied
+        # by the compiler prototype; this is intentionally not a public setting.
+        from .phrase_suppression_tables import get_tables
+        if not table_dir:
+            raise ValueError("Native phrase suppression requires validated tables")
+        arrays = get_tables()
+        expected = {
+            "token_prefix_id", "token_body_id", "bridge_table", "lex_table",
+            "body_table", "body_nonempty", "body_tail",
+        }
+        if not expected.issubset(arrays):
+            raise ValueError("Incomplete native phrase suppression tables")
+        self.vocab = len(arrays["token_prefix_id"])
+        self.n_utf, self.n_prefixes = arrays["bridge_table"].shape
+        self.n_lex, self.n_bodies = arrays["body_table"].shape
+        if self.vocab != req_states.vocab_size or self.n_lex != 31:
+            raise ValueError("Phrase suppression table/model mismatch")
+        if sum(arrays[name].nbytes for name in expected) > 64 * 1024 * 1024:
+            raise ValueError("Phrase suppression tables exceed memory bound")
+        self.tables = tuple(torch.from_numpy(np.array(arrays[name], copy=True)).to(
+            device=req_states.device
+        ) for name in (
+            "token_prefix_id", "token_body_id", "bridge_table", "lex_table",
+            "body_table", "body_nonempty", "body_tail",
+        ))
+        self.state = StagedWriteTensor(
+            (req_states.max_num_reqs, _STATE_WIDTH), dtype=torch.int32,
+            device=req_states.device,
+        )
+
+    def add_request(self, req_idx, prompt_len, sampling_params):
+        metadata = getattr(sampling_params, "_ds41f_phrase_suppression", None)
+        self.use_suppression[req_idx] = False
+        if metadata is not None and not self.enabled:
+            raise ValueError("Native phrase suppression request on disabled worker")
+        if not self.enabled:
+            return
+        seed = [0, 0, 0, int(prompt_len), 0, 0, 0, int(prompt_len)]
+        if metadata is not None:
+            if (not isinstance(metadata, (tuple, list)) or len(metadata) != 3
+                    or any(type(value) is not int for value in metadata)):
+                raise ValueError("Invalid internal phrase suppression state")
+            version, lex, utf = metadata
+            if version != 1 or not 0 <= lex < self.n_lex or not 0 <= utf < self.n_utf:
+                raise ValueError("Invalid internal phrase suppression seed")
+            if type(prompt_len) is not int or prompt_len < 0:
+                raise ValueError("Invalid phrase suppression prompt boundary")
+            seed = [lex, utf, 0, prompt_len, 1, lex, utf, prompt_len]
+            self.use_suppression[req_idx] = True
+        # Always reset a reused slot, including inactive requests.
+        self._pending_resets[req_idx] = seed
+
+    def remove_request(self, req_idx):
+        self.use_suppression[req_idx] = False
+        if self.enabled:
+            self._pending_resets[req_idx] = [0] * _STATE_WIDTH
+
+    def apply_staged_writes(self):
+        if self.enabled:
+            # StagedWriteTensor dispatches writes in parallel. Collapse a
+            # remove/add/reuse sequence to one final reset for each slot.
+            for req_idx, seed in self._pending_resets.items():
+                self.state.stage_write(req_idx, 0, seed)
+            self._pending_resets.clear()
+            self.state.apply_write()
+
+    def apply(self, logits, expanded_idx_mapping, idx_mapping, idx_mapping_np,
+              input_ids, expanded_local_pos):
+        if not self.enabled or not np.any(self.use_suppression[idx_mapping_np]):
+            return
+        assert self.tables is not None
+        if logits.shape[1] != self.vocab:
+            raise ValueError("Phrase suppression logits vocabulary mismatch")
+        _update_committed[(idx_mapping.shape[0],)](
+            idx_mapping, self.state.gpu, self.req_states.all_token_ids.gpu,
+            self.req_states.all_token_ids.gpu.stride(0), self.req_states.total_len.gpu,
+            *self.tables, self.n_prefixes, self.n_bodies, num_warps=1,
+        )
+        _mask_rows[(logits.shape[0], triton.cdiv(self.vocab, 256))](
+            logits, logits.stride(0), expanded_idx_mapping, expanded_local_pos,
+            input_ids, self.state.gpu, *self.tables,
+            self.n_prefixes, self.n_bodies, self.vocab, 256, num_warps=4,
+        )
